# Base SQLite locale. Chemin relatif à la racine du projet.
DATABASE_URL="file:./prisma/dev.db"

# Optionnel. L'application fonctionne intégralement sans cette clé : le bouton
# « Analyser avec l'IA » est alors désactivé, l'analyse par règles reste
# disponible. Jamais de préfixe NEXT_PUBLIC_ : cette clé ne doit pas atteindre
# le navigateur.
ANTHROPIC_API_KEY=
