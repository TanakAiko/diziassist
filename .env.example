# Base SQLite locale. Chemin relatif à la racine du projet.
DATABASE_URL="file:./prisma/dev.db"

# Optionnel. L'application fonctionne intégralement sans cette clé :
# l'extraction par règles est le socle, l'IA n'est qu'une surcouche.
