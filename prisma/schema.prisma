// Schéma diziAssist — voir docs/note-architecture.md, section 3.
// SQLite ne supporte pas `enum` : les valeurs autorisées sont contraintes
// côté TypeScript dans src/lib/constants.ts.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Meeting {
  id          String    @id @default(cuid())
  title       String
  meetingDate DateTime
  rawContent  String
  reviewedAt  DateTime? // null = extraction en attente de validation
  createdAt   DateTime  @default(now())

  // L'extraction par règles est déterministe et gratuite : elle est rejouée à
  // chaque affichage. L'extraction par IA ne l'est pas — un appel facturé dont
  // le résultat varie — sa proposition est donc mémorisée ici, en JSON, jusqu'à
  // la validation. null signifie « analysé par les règles ».
  aiProposal String?
  // Motif d'échec de l'IA, affiché en clair. L'analyse retombe alors sur les
  // règles : l'utilisateur n'est jamais bloqué par une panne de l'API.
  aiError    String?

  items Item[]
}

model Item {
  id            String    @id @default(cuid())
  kind          String    @default("action") // action | pending | info
  description   String
  owner         String? // null si non explicite dans le texte source
  dueDate       DateTime? // null si non explicite dans le texte source
  priority      String? // basse | moyenne | haute
  status        String? // a_faire | en_cours | termine
  needsReview   Boolean   @default(false)
  reviewReason  String? // motif en clair, affiché à l'utilisateur
  sourceExcerpt String // obligatoire : preuve d'origine de l'élément
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  meetingId     String
  meeting       Meeting   @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([kind, status])
  @@index([dueDate])
  @@index([meetingId])
}
